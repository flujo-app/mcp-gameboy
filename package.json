{
  "name": "mcp-gameboy",
  "version": "1.0.0",
  "description": "GameBoy emulator MCP server with bounded execution and an authenticated web interface",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-gameboy": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "vendor/serverboy"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT AND GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mario-andreschak/mcp-gameboy.git"
  },
  "homepage": "https://github.com/mario-andreschak/mcp-gameboy#readme",
  "bugs": {
    "url": "https://github.com/mario-andreschak/mcp-gameboy/issues"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start-sse": "node dist/index.js --sse",
    "test": "npm run build && vitest run",
    "lint": "tsc --noEmit",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "prepack": "npm run build",
    "test:wire": "npm run build && node scripts/wire-smoke.mjs",
    "test:docker": "node scripts/docker-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server-legacy": "^2.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "pngjs": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.3",
    "vitest": "4.1.9",
    "puppeteer": "^25.10.0",
    "vite": "8.1.3"
  }
}
